# ==========================================
# Swaylock Configuration
# ==========================================

# --- General Settings ---
ignore-empty-password
show-failed-attempts
indicator-idle-visible

# --- Background ---
# Replace this with the path to your favorite wallpaper
image=~/.config/ml4w/wallpapers/3d-tech.jpg

# --- Ring Sizing & Font ---
indicator-radius=120
indicator-thickness=12
font=Ubuntu
font-size=24

# --- Colors (Catppuccin Mocha Theme) ---
# Background fallback color (if image fails)
color=1e1e2e

# Inside of the ring (Transparent so we can see the image)
inside-color=00000000
inside-clear-color=00000000
inside-ver-color=00000000
inside-wrong-color=f38ba8

# The ring itself
ring-color=89b4fa         # Default blue
ring-clear-color=f5e0dc   # Rosewater for clearing
ring-ver-color=a6e3a1     # Green for verifying
ring-wrong-color=f38ba8   # Red for wrong password

# Keypress highlights
key-hl-color=cba6f7       # Purple when a key is pressed
bs-hl-color=f38ba8        # Red when backspace is pressed

# Text colors
text-color=cdd6f4
text-clear-color=1e1e2e
text-ver-color=1e1e2e
text-wrong-color=1e1e2e

# Line between the inside and the ring (set to transparent for a cleaner look)
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000